meta {
  name: Create Transaction
  type: http
  seq: 3
}

post {
  url: http://localhost:3001/api/transactions
  body: json
  auth: inherit
}

json {
  {
    "ownerId": "owner-id-here",
    "accountId": "account-id-here",
    "categoryId": "category-id-here",
    "amount": 1000.50,
    "type": -1,
    "date": "2026-02-26"
  }
}

# type: -1 = расход (expense), 1 = доход (income)
# date format: YYYY-MM-DD
