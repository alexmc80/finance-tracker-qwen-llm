meta {
  name: Update Transaction
  type: http
  seq: 4
}

put {
  url: http://localhost:3001/api/transactions/{{transactionId}}
  body: json
  auth: inherit
}

params {
  transactionId: transaction-id-here
}

json {
  {
    "amount": 1500.00,
    "type": 1,
    "date": "2026-02-27"
  }
}

# type: -1 = расход (expense), 1 = доход (income)
# date format: YYYY-MM-DD
